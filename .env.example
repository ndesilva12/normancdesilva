# Firebase Configuration
# Get these from: https://console.firebase.google.com -> Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# AI API Keys
# Grok (xAI) - https://console.x.ai/
XAI_API_KEY=your-xai-api-key

# Claude (Anthropic) - https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Gemini (Google) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ChatGPT (OpenAI) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Google OAuth (for Calendar, Drive, Gmail, Contacts)
# Get these from: https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/google/callback

# Microsoft OAuth (for OneNote - deprecated, using Notion instead)
# Get these from: https://portal.azure.com -> App registrations
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://your-domain.vercel.app/api/auth/microsoft/callback

# Notion (for Notes)
# Get these from: https://www.notion.so/my-integrations
NOTION_INTEGRATION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID=your-notion-database-id

# Research Tools API Keys

# Brave Search API (for Curate and Last 30 Days tools)
# Get from: https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key

# xAI API (for Curate tool - X/Twitter search)
# Get from: https://console.x.ai/
XAI_API_KEY=your-xai-api-key
